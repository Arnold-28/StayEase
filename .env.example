# ──────────────────────────────────────────────
# StayEase — Environment Configuration
# Copy to .env and fill in production values
# ──────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL
POSTGRES_USER=stayease_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=stayease_db

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# JWT Secrets (use `openssl rand -hex 64` to generate)
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret

# Admin Panel Secret
ADMIN_SECRET=CHANGE_ME_admin_secret

# Session Secret
SESSION_SECRET=CHANGE_ME_session_secret

# URLs
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=stayease-uploads

# Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Logging
LOG_LEVEL=info
